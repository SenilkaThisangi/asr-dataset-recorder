# Copy this file to .env for local development (never commit the real .env).

# The spreadsheetId from the Google Sheet's URL:
# https://docs.google.com/spreadsheets/d/SHEET_ID/edit
SHEET_ID=

# Name of the tab/worksheet containing the utterance rows.
SHEET_TAB_NAME=Sheet1

# The folder ID from the parent Google Drive folder's URL:
# https://drive.google.com/drive/folders/DRIVE_PARENT_FOLDER_ID
DRIVE_PARENT_FOLDER_ID=

# The FULL JSON key file contents for the service account, as a single-line string.
# Used for Google Sheets access only.
# Example: GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n",...}
GOOGLE_SERVICE_ACCOUNT_JSON=

# Drive uploads use OAuth-delegated user credentials instead of the service
# account, because service accounts have no storage quota on personal (non-
# Workspace) Google accounts. Generate both of these once via:
#   python -m app.authorize_drive /path/to/client_secret_XXXX.json
GOOGLE_OAUTH_CLIENT_JSON=
GOOGLE_OAUTH_REFRESH_TOKEN=
